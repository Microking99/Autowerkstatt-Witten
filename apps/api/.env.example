# Vorlage für apps/api/.env (NIE echte Werte einchecken; .env ist in .gitignore).
# Alle Werte werden beim Start mit zod geprüft (src/config.ts).

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# Lokaler Cluster: pnpm --filter @werkstatt/api db:start
DATABASE_URL=postgres://werkstatt@127.0.0.1:54329/werkstatt_dev
# Für Tests (Standard: lokaler Cluster, Datenbank werkstatt_test)
# TEST_DATABASE_URL=postgres://werkstatt@127.0.0.1:54329/werkstatt_test

# Herkünfte der Clients (Browser, Windows-Hülle), kommagetrennt
APP_ORIGINS=http://localhost:8081,http://localhost:19006,tauri://localhost
# Basis-URL der App für Links (Einladung, Passwort, QR, Freigabelink, Zahlungs-Rückkehrseite)
APP_BASE_URL=http://localhost:8081
# Öffentlich erreichbare URL dieser API (Webhook-Adresse für SumUp)
API_PUBLIC_URL=http://localhost:3000

# Dateiablage (lokal); später S3-kompatibel (EU)
FILE_STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=15728640

SESSION_TTL_HOURS=720
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# Zahlungen: fake (nur Entwicklung/Tests) oder sumup
PAYMENT_PROVIDER=fake
# Nur für PAYMENT_PROVIDER=sumup (Testzugang: Schlüssel mit sup_sk_test_…)
# SUMUP_API_KEY=
# SUMUP_MERCHANT_CODE=
# SUMUP_API_BASE=https://api.sumup.com
# Echte Zahlungen nur mit ausdrücklicher Freigabe des Inhabers:
ALLOW_LIVE_PAYMENTS=false
PAYMENT_REFRESH_MIN_SECONDS=10

# E-Mail: log (nicht versenden; Inhalte nur in MAIL_LOG_DIR) oder smtp
MAIL_MODE=log
MAIL_LOG_DIR=./.data/mails
MAIL_FROM=Autowerkstatt Witten <no-reply@localhost>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Push: log oder expo (Expo Push API)
PUSH_MODE=log
# EXPO_ACCESS_TOKEN=

BACKGROUND_JOBS=true
NOTIFICATION_INTERVAL_SECONDS=15
RECONCILE_INTERVAL_SECONDS=300

# Seed: für diese Adresse wird eine Admin-Einladung erzeugt (kein Standardpasswort)
# ADMIN_EMAIL=inhaber@example.org
