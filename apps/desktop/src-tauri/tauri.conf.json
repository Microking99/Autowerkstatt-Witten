{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autowerkstatt Witten",
  "version": "0.1.0",
  "identifier": "de.autowerkstattwitten.desktop",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:8081"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Autowerkstatt Witten",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://localhost:3000; connect-src 'self' http://localhost:3000 ws://localhost:3000; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Business",
    "shortDescription": "Werkstattsoftware der Autowerkstatt Witten",
    "longDescription": "Aufträge, Termine, Kunden, Fahrzeuge, Freigaben, Rechnungen und Servicehistorie der Autowerkstatt Witten.",
    "copyright": "Autowerkstatt Witten",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
