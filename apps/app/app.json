{
  "expo": {
    "name": "Autowerkstatt Witten",
    "slug": "autowerkstatt-witten",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "autowerkstatt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "de.autowerkstattwitten.app",
      "supportsTablet": true
    },
    "android": {
      "package": "de.autowerkstattwitten.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B5F6B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "Autowerkstatt Witten",
      "shortName": "Werkstatt Witten",
      "lang": "de",
      "themeColor": "#0B5F6B",
      "backgroundColor": "#F3F4F6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F4F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0F1215",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Die App greift auf Ihre Fotos zu, damit Sie der Werkstatt im Auftrags-Chat ein Foto senden können.",
          "cameraPermission": "Die App nutzt die Kamera, damit Sie der Werkstatt im Auftrags-Chat ein Foto senden können.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B5F6B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
